# ==============================================================================
# ConsensusDev AI Engine — Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OpenRouter API Keys for the 4 AI Agents
# ------------------------------------------------------------------------------
# Paste your OpenRouter API keys below for each agent (starts with sk-or-v1-...):
OPENROUTER_API_KEY_SECURITY=sk-or-v1-your-security-agent-key-here
OPENROUTER_API_KEY_TECH_DEBT=sk-or-v1-your-tech-debt-agent-key-here
OPENROUTER_API_KEY_STORY=sk-or-v1-your-story-match-agent-key-here
OPENROUTER_API_KEY_PERFORMANCE=sk-or-v1-your-performance-agent-key-here

# Optional: Shared fallback OpenRouter key (used if individual agent key is left blank)
OPENROUTER_API_KEY=

# ------------------------------------------------------------------------------
# 2. OpenRouter Models for Each Agent (Optional - Defaults to openai/gpt-4o-mini)
# ------------------------------------------------------------------------------
SECURITY_AGENT_MODEL=openai/gpt-4o-mini
TECH_DEBT_AGENT_MODEL=openai/gpt-4o-mini
STORY_AGENT_MODEL=openai/gpt-4o-mini
PERFORMANCE_AGENT_MODEL=openai/gpt-4o-mini

# Global default model fallback
OPENROUTER_MODEL=openai/gpt-4o-mini
AI_MODEL_NAME=openai/gpt-4o-mini

# ------------------------------------------------------------------------------
# 3. Gateway Configuration (Port 8000)
# ------------------------------------------------------------------------------
GITHUB_TOKEN=ghp_your_github_token_here
WEBHOOK_SECRET=your_webhook_secret_here

# ------------------------------------------------------------------------------
# 4. DevSecOps & QA Service Configurations
# ------------------------------------------------------------------------------
TRIVY_PATH=trivy
CHECKOV_PATH=checkov
PYTEST_PATH=pytest

# ------------------------------------------------------------------------------
# 5. Portal & Documentation Service (Port 8004 / 8501)
# ------------------------------------------------------------------------------
PORTAL_PORT=8004
STREAMLIT_PORT=8501
