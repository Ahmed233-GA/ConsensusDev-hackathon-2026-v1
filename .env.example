# ConsensusDev System Configuration

# -------------------------------------------------------------
# 1. Gateway & Orchestrator (Port 8000)
# -------------------------------------------------------------
WEBHOOK_SECRET=your_github_webhook_hmac_secret_here
WEBHOOK_ALLOW_UNSIGNED_DEV=false
AUTO_MERGE_ENABLED=false
CONSENSUS_MIN_SCORE=80
MIN_COVERAGE_PERCENTAGE=80.0
MIN_MUTATION_SCORE=70.0

# -------------------------------------------------------------
# 2. GitHub Bot Client
# -------------------------------------------------------------
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
GITHUB_REPO_OWNER=Ahmed233-GA
GITHUB_REPO_NAME=ConsensusDev-hackathon-2026-v1

# -------------------------------------------------------------
# 3. Microservice Network Endpoints
# -------------------------------------------------------------
GATEWAY_URL=http://localhost:8000
AI_ENGINE_URL=http://localhost:8001/analyze-pr
SECURITY_SCANNER_URL=http://localhost:8002/scan
QA_RUNNER_URL=http://localhost:8003/run-tests
PORTAL_DOCS_URL=http://localhost:8004/update-docs

# -------------------------------------------------------------
# 4. AI Engine & OpenRouter LLM Configuration (Port 8001)
# -------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini

# Specific Agent Model Overrides (Optional)
SECURITY_AGENT_MODEL=openai/gpt-4o-mini
TECH_DEBT_AGENT_MODEL=openai/gpt-4o-mini
STORY_AGENT_MODEL=openai/gpt-4o-mini
PERFORMANCE_AGENT_MODEL=openai/gpt-4o-mini

# -------------------------------------------------------------
# 5. Security Scanners Configuration (Port 8002)
# -------------------------------------------------------------
CHECKOV_PATH=checkov
TRIVY_PATH=trivy
